<Project Sdk="Microsoft.NET.Sdk">

  <!-- The part of NextProject that has no web types: the rules of progress, TOTP, password hashing. Everything in here is covered by unit tests
       without a browser or a database. -->

  <PropertyGroup>
    <RootNamespace>NextProject.Core</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NextProject.Tests" />
  </ItemGroup>

</Project>
