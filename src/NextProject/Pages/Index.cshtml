@page
@model NextProject.Pages.IndexModel

<section class="np-hero" aria-labelledby="hero-title">
    <span class="np-hero__mark" aria-hidden="true">@Ui.Icon("np-logo")</span>
    <div class="np-hero__text">
        <p class="np-hero__kicker">@Model.Today.ToString("dddd, d. MMMM yyyy", Fmt.Culture)</p>
        <h1 id="hero-title">Hallo@(Model.FirstName.Length > 0 ? ", " + Model.FirstName : "")</h1>
        <p class="np-hero__line">
            @if (Model.MyOpen == 0) { <span>Du hast nichts offen. Zeit für etwas Neues.</span> }
            else { <span>Du hast @Ui.Plural(Model.MyOpen, "offenes Todo", "offene Todos")@(Model.MyOverdue > 0 ? ", " + Model.MyOverdue + " davon überfällig" : "").</span> }
        </p>
        <div class="np-hero__actions">
            <a class="np-btn-light" href="/Todos/Edit">@Ui.Icon("plus")<span>Neues Todo</span></a>
            <a class="np-btn-outline-light" href="/Todos/Board?mine=true">@Ui.Icon("columns")<span>Mein Board</span></a>
            <a class="np-btn-outline-light" href="/Calendar">@Ui.Icon("calendar")<span>Kalender</span></a>
        </div>
    </div>
</section>

@if (Model.IsEmpty)
{
    <np-card title="Los geht's" icon="rocket" sub="drei Schritte">
        <ul class="mat-listgroup mat-listgroup--flush">
            <li><a class="mat-listgroup__item" href="/Goals/Edit">@Ui.Icon("target")<span class="mat-listgroup__text"><strong>1. Ein Ziel anlegen</strong><small>Was soll das Unternehmen erreichen, und woran misst du es?</small></span></a></li>
            <li><a class="mat-listgroup__item" href="/Projects/Edit">@Ui.Icon("folder")<span class="mat-listgroup__text"><strong>2. Ein Projekt anlegen</strong><small>Welche Initiative zahlt auf das Ziel ein, und wer ist der Projektowner?</small></span></a></li>
            <li><a class="mat-listgroup__item" href="/Todos/Edit">@Ui.Icon("check-square")<span class="mat-listgroup__text"><strong>3. Ein Todo anlegen</strong><small>Eine Aufgabe mit einer verantwortlichen Person und einem Termin.</small></span></a></li>
        </ul>
        @if (User.IsInRole("Admin"))
        {
            <p class="mat-hint">Zum Ausprobieren gibt es unter Einstellungen › System Beispieldaten.</p>
        }
    </np-card>
}

<div class="np-kpis">
    @Ui.Kpi("Meine Todos", Model.MyOpen.ToString(), Model.MyOverdue > 0 ? Model.MyOverdue + " überfällig" : "nichts überfällig", "check-square", "accent", "/Todos", Model.MyOverdue > 0)
    @Ui.Kpi("Meine Projekte", Model.MyProjects.ToString(), Model.MyProjectsAtRisk > 0 ? Model.MyProjectsAtRisk + " gefährdet" : "keins gefährdet", "folder", "busy", "/Projects", Model.MyProjectsAtRisk > 0)
    @Ui.Kpi("Ziele / Key Results", Model.ActiveGoals + " / " + Model.KeyResults, Model.KeyResultsLate > 0 ? Model.KeyResultsLate + " im Rückstand" : "kein Rückstand", "target", "info", "/Goals", Model.KeyResultsLate > 0)
    @Ui.Kpi("Team-Status", Ui.Pill(Model.TeamState, Model.TeamState == "Gut" ? "ok" : Model.TeamState == "Achtung" ? "error" : "warn"), (Model.TeamBlocked > 0 ? Model.TeamBlocked + " blockiert" : "keine Blockaden") + (Model.TeamOverdue > 0 ? ", " + Model.TeamOverdue + " überfällig" : ""), "users", Model.TeamState == "Gut" ? "ok" : Model.TeamState == "Achtung" ? "error" : "warn", "/Reports", Model.TeamBlocked > 0 || Model.TeamOverdue > 0)
</div>

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-7 mat-stack">
        <np-card title="Meine heutigen Aufgaben" icon="check-square" sub="@Fmt.Date(Model.Today)">
            @if (Model.TodayTodos.Count == 0)
            {
                <p class="mat-muted">Für heute ist nichts fällig und nichts in Arbeit. Zeit für etwas Neues oder für einen Blick auf die Woche.</p>
            }
            else
            {
                <ul class="mat-listgroup mat-listgroup--flush">
                    @foreach (var t in Model.TodayTodos)
                    {
                        var overdue = t.IsOverdue(Model.Today);
                        <li class="np-attachment">
                            <span class="np-attachment__check">@TodoTable.Check(t)</span>
                            <a class="mat-listgroup__item" href="/Todos/Details?id=@t.Id"><span class="mat-listgroup__text"><strong>@t.Title</strong><small>@(t.Project?.Name ?? "eigenständig")</small></span>@Labels.Pill(t.Status)<span class="np-due @(overdue ? "np-overdue" : "mat-muted")">@(t.DueDate is null ? "" : Fmt.Due(t.DueDate, Model.Today))</span></a>
                        </li>
                    }
                </ul>
            }

            <div class="mat-actions np-addform">
                <a class="mat-btn mat-btn--primary" href="/Todos/Edit">@Ui.Icon("plus")<span>Neues Todo</span></a>
                <a class="mat-btn mat-btn--secondary" href="/Todos">@Ui.Icon("list")<span>Alle meine Todos</span></a>
            </div>
        </np-card>

        @if (Model.SoonTodos.Count > 0)
        {
            <np-card title="Demnächst fällig" icon="calendar">
                <ul class="mat-listgroup mat-listgroup--flush">
                    @foreach (var t in Model.SoonTodos)
                    {
                        <li><a class="mat-listgroup__item" href="/Todos/Details?id=@t.Id">@Ui.Icon("clock")<span class="mat-listgroup__text"><strong>@t.Title</strong><small>@(t.Project?.Name ?? "eigenständig")</small></span><span class="mat-muted">@Fmt.Due(t.DueDate, Model.Today)</span></a></li>
                    }
                </ul>
            </np-card>
        }
    </div>

    <div class="mat-col-12 mat-col-lg-5 mat-stack">
        <np-card title="Projektfortschritt" icon="folder">
            @if (Model.Projects.Count == 0)
            {
                <p class="mat-muted">Du bist an keinem laufenden Projekt beteiligt.</p>
            }
            else
            {
                <ul class="np-projectlist">
                    @foreach (var line in Model.Projects)
                    {
                        <li>
                            <a href="/Projects/Details?id=@line.Project.Id"><strong>@line.Project.Name</strong></a>
                            <div class="np-projectlist__meta">@Labels.Pill(line.Project.Status)@if (line.Facts.IsEndangered) { <span class="np-overdue">@Ui.Icon("alert") gefährdet</span> }</div>
                            @Ui.Meter(line.Facts.Todos.Total - line.Facts.Todos.Discarded > 0 ? line.Facts.Todos.Completion : null, "Erledigte Todos")
                        </li>
                    }
                </ul>
            }

            <div class="mat-actions np-addform"><a class="mat-btn mat-btn--secondary" href="/Projects">@Ui.Icon("folder")<span>Alle Projekte</span></a></div>
        </np-card>

        <np-card title="Risiken & Blockaden" icon="alert">
            @if (Model.Blocked.Count == 0 && Model.Risks.Count == 0)
            {
                <p class="mat-muted">Keine Blockaden und keine hohen Risiken. So soll es sein.</p>
            }
            else
            {
                <ul class="mat-listgroup mat-listgroup--flush">
                    @foreach (var t in Model.Blocked)
                    {
                        <li><a class="mat-listgroup__item" href="/Todos/Details?id=@t.Id">@Ui.Icon("lock")<span class="mat-listgroup__text"><strong>@t.Title</strong><small>@t.OwnerUser?.DisplayName · @t.BlockReason</small></span></a></li>
                    }

                    @foreach (var r in Model.Risks)
                    {
                        <li><a class="mat-listgroup__item" href="/Projects/Details?id=@r.ProjectId&tab=risks">@Ui.Icon("alert")<span class="mat-listgroup__text"><strong>@r.Title</strong><small>@r.Project?.Name · @Labels.Of(r.Status)</small></span></a></li>
                    }
                </ul>
            }
        </np-card>
    </div>
</div>
