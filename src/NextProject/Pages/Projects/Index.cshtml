@page
@model NextProject.Pages.Projects.IndexModel

<div class="mat-list">
    <partial name="_ViewToggle" model="Model.Toggle" />
    <partial name="_Toolbar" model="Model.Toolbar" />
    @if (Model.View == "karten")
    {
        if (Model.Cards.Items.Count == 0)
        {
            <partial name="_Table" model="Model.Table" />
        }
        else
        {
            <partial name="_ProjectCards" model="Model.Cards" />
        }
    }
    else
    {
        <partial name="_Table" model="Model.Table" />
    }
    <partial name="_Pager" model="Model.Pager" />
    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/Projects/Edit">@Ui.Icon("plus")<span>Neues Projekt</span></a>
    </div>
</div>
